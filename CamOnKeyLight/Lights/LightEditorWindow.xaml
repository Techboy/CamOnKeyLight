<Window x:Class="CamOnKeyLight.LightEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add light" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/Resources/Icon.ico">
  <StackPanel Margin="18">
    <TextBlock Text="Address" Style="{StaticResource SectionLabel}"/>
    <TextBox x:Name="AddressBox" Margin="0,4,0,10" AutomationProperties.Name="Address"/>
    <TextBlock Text="Description" Style="{StaticResource SectionLabel}"/>
    <TextBox x:Name="DescriptionBox" Margin="0,4,0,10" AutomationProperties.Name="Description"/>
    <TextBlock Text="Group" Style="{StaticResource SectionLabel}"/>
    <TextBox x:Name="GroupBox" Margin="0,4,0,10" AutomationProperties.Name="Group"/>
    <Button Content="Find lights" HorizontalAlignment="Left" Click="Find_Click" Margin="0,0,0,14" AutomationProperties.Name="Find lights"/>
    <TextBlock x:Name="ErrorText" Style="{StaticResource Hint}" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,8"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" MinWidth="80"/>
    </StackPanel>
  </StackPanel>
</Window>
