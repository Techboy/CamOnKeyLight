<Window x:Class="CamOnKeyLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CamOnKeyLight"
        Title="Cam On Key Light"
        Width="780" Height="860" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Icon.ico">
  <Window.Resources>
    <Style x:Key="LightCardStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="6"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="12">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
      <DockPanel Height="44">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Settings" Click="Settings_Click" Margin="0,0,4,0" AutomationProperties.Name="Settings"/>
          <Button Content="Help" Click="Help_Click" AutomationProperties.Name="Help">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="_Documentation" Click="Documentation_Click"/>
                <MenuItem Header="_Report an issue" Click="Issue_Click"/>
                <MenuItem Header="Release _notes" Click="Releases_Click"/>
                <MenuItem Header="_GitHub project" Click="GitHub_Click"/>
                <MenuItem Header="_Elgato website" Click="Elgato_Click"/>
                <Separator/>
                <MenuItem Header="_About Cam On Key Light" Click="About_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
          <TextBlock Text="Cam On Key Light" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="NoWrap"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="22">
        <Border CornerRadius="16" Padding="22,20" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
              <Border x:Name="HeroLamp1" Width="36" Height="48" CornerRadius="4" Margin="10,0" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"/>
              <Border x:Name="HeroLamp2" Width="36" Height="48" CornerRadius="4" Margin="10,0" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"/>
            </StackPanel>
            <TextBlock x:Name="HeroHeadline" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="NoWrap"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="HeroReason" Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="NoWrap"/>
            <Border x:Name="ModePillBorder" HorizontalAlignment="Center" Margin="0,14,0,0" CornerRadius="999" Padding="10,4" Background="{DynamicResource PillAutoBrush}">
              <TextBlock x:Name="ModePill" FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" Foreground="{DynamicResource PillAutoTextBrush}"/>
            </Border>
          </StackPanel>
        </Border>

        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" x:Name="LightCount" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
          <TextBlock Text="Your lights" Style="{StaticResource SectionLabel}"/>
        </DockPanel>
        <TextBlock x:Name="EmptyLights" Style="{StaticResource Hint}" Margin="0,0,0,8" Text="No lights yet. Add one, or search this network."/>
        <ListBox x:Name="LightList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource LightCardStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Your lights"
                 AutomationProperties.HelpText="Press Enter to edit the selected light. Press Delete to remove it."
                 PreviewKeyDown="LightList_PreviewKeyDown" MouseDoubleClick="LightList_MouseDoubleClick">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:LightCard}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="···" MinWidth="28" MinHeight="28" Padding="4" Margin="8,0,0,0"
                        VerticalAlignment="Center" Click="LightActions_Click" CommandParameter="{Binding Address}"
                        AutomationProperties.Name="{Binding ActionsName}"/>
                <Border x:Name="pill" DockPanel.Dock="Right" CornerRadius="999" Padding="8,3" VerticalAlignment="Center" Background="{DynamicResource PillOffBrush}">
                  <TextBlock x:Name="pillText" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" Foreground="{DynamicResource PillOffTextBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap"/>
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource Hint}" TextWrapping="NoWrap"/>
                </StackPanel>
              </DockPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="On">
                  <Setter TargetName="pill" Property="Background" Value="{DynamicResource PillOnBrush}"/>
                  <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource PillOnTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Problem">
                  <Setter TargetName="pill" Property="Background" Value="{DynamicResource PillOffBrush}"/>
                  <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Pending">
                  <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="ProblemDetail" Foreground="{DynamicResource ErrorBrush}" Margin="0,4,0,8" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
          <Button Content="Add light" Click="Add_Click" Margin="0,0,8,0" AutomationProperties.Name="Add light"/>
          <Button Content="Find lights" Click="Find_Click" Margin="0,0,8,0" AutomationProperties.Name="Find lights"/>
          <Button x:Name="RetryButton" Content="Retry" Click="Retry_Click" AutomationProperties.Name="Retry"/>
        </StackPanel>

        <Border Style="{x:Null}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Light control" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4" MaxWidth="360" HorizontalAlignment="Left">
              <UniformGrid Columns="3">
                <RadioButton x:Name="AutoMode" Content="Auto" GroupName="LightMode" Style="{StaticResource SegmentRadio}" Checked="Mode_Checked" AutomationProperties.Name="Auto"/>
                <RadioButton x:Name="OnMode" Content="On" GroupName="LightMode" Style="{StaticResource SegmentRadio}" Checked="Mode_Checked" AutomationProperties.Name="On"/>
                <RadioButton x:Name="OffMode" Content="Off" GroupName="LightMode" Style="{StaticResource SegmentRadio}" Checked="Mode_Checked" AutomationProperties.Name="Off"/>
              </UniformGrid>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,10"
                       Text="Lights turn on when your camera does. On and Off hold them until you change the mode. Delays apply only in Auto."/>
            <UniformGrid Columns="2">
              <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                <TextBlock Text="Turn on after" VerticalAlignment="Center" Width="110" TextWrapping="NoWrap"/>
                <local:DelayStepper x:Name="OnDelay" AutomationProperties.Name="Turn on after, seconds"/>
                <TextBlock Text="seconds" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="NoWrap"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Turn off after" VerticalAlignment="Center" Width="110" TextWrapping="NoWrap"/>
                <local:DelayStepper x:Name="OffDelay" AutomationProperties.Name="Turn off after, seconds"
                                    AutomationProperties.HelpText="Automatic mode only. After the camera turns off, wait this long before turning the lights off. Manual Off is immediate."/>
                <TextBlock Text="seconds" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="NoWrap"/>
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>

        <UniformGrid Columns="2" Margin="0,0,0,16">
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,6,0">
            <StackPanel>
              <TextBlock Text="This PC" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
              <DockPanel Margin="0,0,0,14">
                <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="StartWithWindows_Click"
                          AutomationProperties.Name="Start when I sign in"/>
                <StackPanel>
                  <TextBlock Text="Start when I sign in" TextWrapping="NoWrap"/>
                  <TextBlock Style="{StaticResource Hint}" Text="Starts after you sign in to Windows."/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="Appearance" Margin="0,0,0,6"/>
              <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                <UniformGrid Columns="3">
                  <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Appearance" Style="{StaticResource SegmentRadio}" Checked="Theme_Checked" AutomationProperties.Name="Dark appearance"/>
                  <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Appearance" Style="{StaticResource SegmentRadio}" Checked="Theme_Checked" AutomationProperties.Name="Light appearance"/>
                  <RadioButton x:Name="ThemeSystem" Content="System" GroupName="Appearance" Style="{StaticResource SegmentRadio}" Checked="Theme_Checked" AutomationProperties.Name="System appearance"/>
                </UniformGrid>
              </Border>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="6,0,0,0">
            <StackPanel>
              <TextBlock Text="Updates" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
              <DockPanel Margin="0,0,0,12">
                <CheckBox x:Name="AutomaticUpdates" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="AutomaticUpdates_Click"
                          AutomationProperties.Name="Install updates automatically"/>
                <StackPanel>
                  <TextBlock Text="Install updates automatically" TextWrapping="Wrap"/>
                  <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}"/>
                </StackPanel>
              </DockPanel>
              <WrapPanel>
                <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" Margin="0,0,8,8" AutomationProperties.Name="Check for updates"/>
                <Button x:Name="InstallUpdateButton" Content="Install update" Click="InstallUpdate_Click" Margin="0,0,8,8" AutomationProperties.Name="Install update"/>
                <Button x:Name="ShortcutsButton" Content="Shortcuts" Click="Shortcuts_Click" Margin="0,0,8,8" AutomationProperties.Name="Keyboard shortcuts"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Style="{StaticResource LinkButton}" Content="Documentation" Click="Documentation_Click" Margin="8,0"/>
          <Button Style="{StaticResource LinkButton}" Content="Report an issue" Click="Issue_Click" Margin="8,0"/>
          <Button Style="{StaticResource LinkButton}" Content="What's new" Click="Releases_Click" Margin="8,0"/>
          <Button Style="{StaticResource LinkButton}" Content="About" Click="About_Click" Margin="8,0"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
