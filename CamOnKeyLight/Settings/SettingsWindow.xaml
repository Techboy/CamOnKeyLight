<Window x:Class="CamOnKeyLight.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CamOnKeyLight"
        Title="Settings" Width="960" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/Resources/Icon.ico">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" AutomationProperties.Name="Cancel"/>
        <Button Content="Save changes" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" AutomationProperties.Name="Save changes"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Left" Width="220" Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,12,0,12">
      <DockPanel>
        <RadioButton DockPanel.Dock="Bottom" x:Name="AboutRadio" Content="About" Tag="about" GroupName="SettingsNav" Style="{StaticResource NavRadio}" Checked="Nav_Checked" AutomationProperties.Name="About"/>
        <StackPanel>
          <RadioButton x:Name="QuietRadio" Content="Quiet hours" Tag="quiet" GroupName="SettingsNav" Style="{StaticResource NavRadio}" IsChecked="True" Checked="Nav_Checked" AutomationProperties.Name="Quiet hours"/>
          <RadioButton x:Name="AppsRadio" Content="Camera apps" Tag="apps" GroupName="SettingsNav" Style="{StaticResource NavRadio}" Checked="Nav_Checked" AutomationProperties.Name="Camera apps"/>
          <RadioButton x:Name="GroupsRadio" Content="Groups" Tag="groups" GroupName="SettingsNav" Style="{StaticResource NavRadio}" Checked="Nav_Checked" AutomationProperties.Name="Groups"/>
          <RadioButton x:Name="NotificationsRadio" Content="Notifications" Tag="notifications" GroupName="SettingsNav" Style="{StaticResource NavRadio}" Checked="Nav_Checked" AutomationProperties.Name="Notifications"/>
          <RadioButton x:Name="RelayRadio" Content="Home relay" Tag="relay" GroupName="SettingsNav" Style="{StaticResource NavRadio}" Checked="Nav_Checked" AutomationProperties.Name="Home relay"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,22,24,16" Background="{DynamicResource WindowBackgroundBrush}">
      <Grid>
        <StackPanel x:Name="QuietPage">
          <TextBlock Text="Quiet hours" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                     Text="During quiet hours, automatic mode does not turn lights on. On and Off from the window and the tray still work. A range that passes midnight, such as 22:00 to 07:00, is supported. If the times match, the selected days are quiet all day."/>
          <CheckBox x:Name="QuietEnabled" Content="Enable quiet hours" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Start" VerticalAlignment="Center" Width="48"/>
            <TextBox x:Name="QuietStart" Width="88" AutomationProperties.Name="Quiet hours start"/>
            <TextBlock Text="End" VerticalAlignment="Center" Width="40" Margin="16,0,0,0"/>
            <TextBox x:Name="QuietEnd" Width="88" AutomationProperties.Name="Quiet hours end"/>
          </StackPanel>
          <StackPanel x:Name="DayPanel" Orientation="Horizontal" Margin="0,8,0,8"/>
          <TextBlock x:Name="QuietError" Foreground="{DynamicResource ErrorBrush}"/>
        </StackPanel>

        <StackPanel x:Name="AppsPage" Visibility="Collapsed">
          <TextBlock Text="Camera apps" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                     Text="All apps is the current behavior. Checked apps are the only ones that count, or the ones that are ignored, depending on the choice below. Names appear after an app uses the camera, or you can type an exe name."/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="ModeAll" Content="All apps" GroupName="CameraApps"/>
            <RadioButton x:Name="ModeOnly" Content="Only these apps" GroupName="CameraApps"/>
            <RadioButton x:Name="ModeExcept" Content="All except these apps" GroupName="CameraApps"/>
          </StackPanel>
          <ListBox x:Name="AppList" Height="180" AutomationProperties.Name="Camera apps">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Name}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="AppName" Width="240" Margin="0,0,8,0" AutomationProperties.Name="App name"/>
            <Button Content="Add" Click="AddApp_Click" Margin="0,0,8,0" AutomationProperties.Name="Add camera app"/>
            <Button Content="Remove" Click="RemoveApp_Click" AutomationProperties.Name="Remove camera app"/>
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="GroupsPage" Visibility="Collapsed">
          <TextBlock Text="Groups" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                     Text="The tray menu can turn a group on or off, or set its brightness. Automatic switching stays per light. Uncheck the box to choose which groups follow the camera. Lights with no group follow the camera only when every group does."/>
          <CheckBox x:Name="AllGroups" Content="All groups follow the camera" Margin="0,0,0,10" Checked="AllGroups_Changed" Unchecked="AllGroups_Changed"/>
          <ListBox x:Name="GroupList" Height="220" AutomationProperties.Name="Groups that follow the camera">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Name}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <StackPanel x:Name="NotificationsPage" Visibility="Collapsed">
          <TextBlock Text="Notifications" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                     Text="Offline and online notices wait about 20 seconds, so a light that flickers does not send a burst of messages. The first check after startup does not notify."/>
          <CheckBox x:Name="NotifyPresence" Content="Notify when a light goes offline or comes back" Margin="0,0,0,10"/>
          <CheckBox x:Name="NotifyUpdate" Content="Notify when an update is installed"/>
        </StackPanel>

        <StackPanel x:Name="RelayPage" Visibility="Collapsed">
          <TextBlock Text="Home relay" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                     Text="Use a relay when this PC cannot reach your lights directly, for example when you are on a work VPN. The app still tries each light first, and only uses the relay if that fails."/>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <DockPanel>
              <CheckBox x:Name="UseRelay" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="UseRelay_Changed" Unchecked="UseRelay_Changed"
                        AutomationProperties.Name="Use a home relay"/>
              <StackPanel>
                <TextBlock Text="Use a home relay" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Hint}" Text="Leave this off if the lights are always on the same network as this PC."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <StackPanel x:Name="RelayFields">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="CONNECTION" Style="{StaticResource GroupTitle}"/>
                <TextBlock Text="Relay address" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Hint}" Text="The public HTTPS address of your relay, such as https://lights.example.com"/>
                <TextBox x:Name="RelayUrl" Margin="0,6,0,0" AutomationProperties.Name="Relay URL"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="CLOUDFLARE ACCESS" Style="{StaticResource GroupTitle}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Only needed if your relay is protected by a Cloudflare Access service token."/>
                <TextBlock Text="Access client ID" FontWeight="SemiBold"/>
                <TextBox x:Name="ClientId" Margin="0,6,0,10" AutomationProperties.Name="Access client ID"/>
                <TextBlock Text="Access client secret" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <local:SecretBox x:Name="ClientSecret"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="SHARED SECRET" Style="{StaticResource GroupTitle}"/>
                <TextBlock Text="Relay shared secret" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Hint}" Text="Must match the shared secret set on the relay container. It is stored with this Windows user only."/>
                <local:SecretBox x:Name="SharedSecret" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="TestRelay" Content="Test relay" Style="{StaticResource PrimaryButton}" Click="TestRelay_Click" VerticalAlignment="Center" AutomationProperties.Name="Test relay"/>
            <Border x:Name="RelayResult" Margin="12,0,0,0" Padding="12,8" CornerRadius="12" BorderThickness="1" Visibility="Collapsed" VerticalAlignment="Center">
              <StackPanel>
                <TextBlock x:Name="RelayTitle" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                <TextBlock x:Name="RelayDetail" Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock x:Name="RelayError" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,8"/>
          <Button Style="{StaticResource LinkButton}" Content="View the relay guide on GitHub" HorizontalAlignment="Left" Click="RelayGuide_Click"
                  AutomationProperties.Name="View the relay guide on GitHub"/>
        </StackPanel>

        <StackPanel x:Name="AboutPage" Visibility="Collapsed">
          <local:AboutView/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
