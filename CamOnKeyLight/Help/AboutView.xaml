<UserControl x:Class="CamOnKeyLight.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Width="72" Height="72" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,8"
            Background="{DynamicResource AccentBrush}"/>
    <TextBlock Text="Cam On Key Light" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,2,0,8" TextWrapping="NoWrap"/>
    <TextBlock TextAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"
               Text="Turns your Elgato Key Lights on and off when your webcam turns on or off. You can also hold the lights on or off yourself."/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
      <TextBlock Style="{StaticResource Hint}"
                 Text="Cam On Key Light is an independent app. It is not made, sold or endorsed by Elgato."/>
    </Border>
    <StackPanel>
      <Button Style="{StaticResource LinkRow}" Content="Documentation" Click="Documentation_Click" Margin="0,0,0,6"
              AutomationProperties.Name="Documentation, opens in the browser"/>
      <Button Style="{StaticResource LinkRow}" Content="Report an issue" Click="Issue_Click" Margin="0,0,0,6"
              AutomationProperties.Name="Report an issue, opens in the browser"/>
      <Button Style="{StaticResource LinkRow}" Content="What's new and releases" Click="Releases_Click" Margin="0,0,0,6"
              AutomationProperties.Name="What's new and releases, opens in the browser"/>
      <Button Style="{StaticResource LinkRow}" Content="github.com/Techboy/CamOnKeyLight" Click="GitHub_Click"
              AutomationProperties.Name="GitHub project, opens in the browser"/>
    </StackPanel>
    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,12,0,4"
               Text="MIT Licence · Copyright © 2022 Gabriel Garcia"/>
    <Button Style="{StaticResource LinkButton}" Content="https://www.elgato.com/" HorizontalAlignment="Center" Click="Elgato_Click"
            AutomationProperties.Name="Elgato website, opens in the browser"/>
  </StackPanel>
</UserControl>
