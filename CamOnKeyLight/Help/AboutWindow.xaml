<Window x:Class="CamOnKeyLight.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CamOnKeyLight"
        Title="About Cam On Key Light"
        Width="480" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/Resources/Icon.ico">
  <DockPanel Margin="22">
    <Button DockPanel.Dock="Bottom" Content="Close" MinWidth="96" HorizontalAlignment="Center" Margin="0,16,0,0"
            IsCancel="True" IsDefault="True" AutomationProperties.Name="Close"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <local:AboutView/>
    </ScrollViewer>
  </DockPanel>
</Window>
