<UserControl x:Class="CamOnKeyLight.DelayStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32" MinWidth="92">
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource InputBrush}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Width="28">
        <Button x:Name="Up" Content="&#x25B2;" Padding="0" MinHeight="15" FontSize="8" Click="Up_Click" BorderThickness="0,0,0,1"
                AutomationProperties.Name="Increase"/>
        <Button x:Name="Down" Content="&#x25BC;" Padding="0" MinHeight="15" FontSize="8" Click="Down_Click" BorderThickness="0"
                AutomationProperties.Name="Decrease"/>
      </StackPanel>
      <TextBox x:Name="Box" BorderThickness="0" Background="Transparent" TextAlignment="Right" Padding="8,4"
               VerticalContentAlignment="Center" LostFocus="Box_LostFocus" PreviewKeyDown="Box_PreviewKeyDown"/>
    </DockPanel>
  </Border>
</UserControl>
