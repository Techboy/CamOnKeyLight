<UserControl x:Class="CamOnKeyLight.SecretBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="36">
  <Grid>
    <PasswordBox x:Name="Hidden" Padding="10,6,72,6"/>
    <TextBox x:Name="Clear" Padding="10,6,72,6" Visibility="Collapsed"/>
    <Button x:Name="Toggle" Content="Show" HorizontalAlignment="Right" VerticalAlignment="Center"
            Margin="0,0,4,0" MinWidth="60" MinHeight="28" Padding="8,4" Click="Toggle_Click"/>
  </Grid>
</UserControl>
