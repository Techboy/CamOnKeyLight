<Window x:Class="CamOnKeyLight.FindLightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find lights" Width="520" Height="420" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icon.ico">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" AutomationProperties.Name="Cancel"/>
      <Button Content="Search again" Click="Again_Click" Margin="0,0,8,0" AutomationProperties.Name="Search again"/>
      <Button x:Name="UseButton" Content="Add" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Use_Click" IsEnabled="False"/>
    </StackPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Searching the network…"/>
    <ListView x:Name="Lights" AutomationProperties.Name="Discovered lights">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
          <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}" Width="150"/>
          <GridViewColumn Header="Port" DisplayMemberBinding="{Binding Port}" Width="70"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
